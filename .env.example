# RunRush Environment Configuration Template
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# ----------------- Flask Environment -----------------
FLASK_ENV=development
# Generate a strong key for production with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ----------------- Database -----------------
# Local development (SQLite):
DATABASE_URL=sqlite:///runs.db

# Production (PostgreSQL on Render):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ----------------- Redis (Optional, for rate limiting storage) -----------------
# REDIS_URL=redis://localhost:6379/0

# ----------------- Admin Configuration -----------------
ADMIN_USER_ID=1

# ----------------- Integrations -----------------
# Open-Meteo Weather Integration (Uses historical/forecast api - API Key optional)
WEATHER_API_KEY=

# Email notifications (Resend integration)
RESEND_API_KEY=
RESEND_FROM_EMAIL=RunRush <noreply@runrush.app>
